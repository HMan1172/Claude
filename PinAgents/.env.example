# Pick one: anthropic, openai, ollama, mock (offline test, no key)
PINAGENTS_LLM_PROVIDER=mock

# Keys (only the one for your provider is needed)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides
# PINAGENTS_QUICK_LLM=claude-haiku-5-5
# PINAGENTS_DEEP_LLM=claude-sonnet-5-5

# Free local models with Ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Stage 2: official Pinterest API (needs Standard access)
# PINTEREST_ACCESS_TOKEN=
# PINTEREST_BOARD_ID=
# PINAGENTS_ALLOW_POSTING=1

# Unattended runs: lets autopilot refresh the token itself (refresh tokens last 60 days and
# are replaced on every refresh; the newest is kept in ~/.pinagents/pinterest_token.json)
# PINTEREST_APP_ID=
# PINTEREST_APP_SECRET=
# PINTEREST_REFRESH_TOKEN=

# Product discovery and earnings from CJ Affiliate (lets autopilot run without a products CSV)
# CJ_API_TOKEN=
# CJ_COMPANY_ID=
# CJ_WEBSITE_ID=

# Stage 3: ads (needs an ad account with billing and the ads:write scope)
# PINTEREST_AD_ACCOUNT_ID=
# PINAGENTS_ALLOW_ADS=1
# PINAGENTS_ADS_DAILY_CAP=5.00
# PINAGENTS_ADS_TOTAL_CAP=100.00
# PINAGENTS_AD_GROUP_BUDGET=1.00
# PINAGENTS_MAX_PRODUCTS=5
# PINAGENTS_PINS_PER_DAY=3
# product_id,date,earnings from your affiliate network, earned through ad links only
# PINAGENTS_EARNINGS_CSV=
